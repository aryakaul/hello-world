			"respelling": "AH-kam BOOL-teh", "status": "ai",
			"note": "'How did you pass the night?'; men and women alike."},
		"good_evening": {"native": "Akkam oolte?",
			"respelling": "AH-kam OHL-teh", "status": "ai",
			"note": "'How was your day?'; used from afternoon on."},
		"goodbye": {"native": "Nagaatti",
			"respelling": "nah-GAA-tee", "status": "ai",
			"note": "'In peace' - the everyday goodbye."},
		"how_are_you": {"native": "Akkam jirta?",
			"respelling": "AH-kam JEER-tah", "status": "ai",
			"note": "Answer: nagaa dha (nah-GAA dah), 'I am well'."},
		"thank_you": {"native": "Galatoomi",
			"respelling": "gah-lah-TOH-mee", "status": "ai",
			"note": "To more than one person: galatoomaa."},
		"youre_welcome": {"native": "Homaa miti",
