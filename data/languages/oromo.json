			"respelling": "rah-KOH hin QAH-boo", "status": "ai",
			"note": "'It has no problem'; rakkoo means 'problem'."},
		"please": {"native": "Maaloo",
			"respelling": "MAA-loh", "status": "ai",
			"note": "Softens any request; safe with a stranger."},
		"excuse_me": {"native": "Dhiifama",
			"respelling": "dee-FAH-mah", "status": "ai",
			"note": "The dh is a soft d, tongue curled back."},
		"sorry": {"native": "Naaf dhiifama",
			"respelling": "NAAF dee-FAH-mah", "status": "ai",
			"note": "'Forgive me'; plain dhiifama also works."},
		"yes": {"native": "Eeyyee",
			"respelling": "AY-yay", "status": "ai",
			"note": "Doubled letters are held long: ay-y-yay."},
		"no": {"native": "Lakki",
			"respelling": "LAH-kee", "status": "ai",
			"note": "Also miti (MEE-tee), 'it is not'."},
		"of_course": {"native": "Eeyyee kaa",
			"respelling": "AY-yay KAA", "status": "ai",
			"note": "'Yes indeed' - the natural everyday 'of course'."},
		"amazing": {"native": "Baay'ee bareedaa!",
			"respelling": "BAA-yay bah-RAY-daa", "status": "ai",
			"note": "'Very lovely'; the ' is a small catch in the throat."},
		"delicious": {"native": "Baay'ee mi'aawaa!",
			"respelling": "BAA-yay mee-AA-waa", "status": "ai",
			"note": "'Very tasty'; the ' marks that same little catch."},
		"cheers": {"native": "Fayyaa keenyaaf!",
			"respelling": "FAI-yaa KAY-nyaaf", "status": "ai",
			"note": "'To our health'; toasting is a borrowed habit."}
