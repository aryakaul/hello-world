				"native": "جامد",
				"respelling": "GAH-med",
				"note": "Casual praise, like 'awesome'; friends, not elders.",
				"status": "ai"
			}},
		"delicious": {"native": "لذيذ",
			"respelling": "lah-ZEEZ", "status": "ai"},
