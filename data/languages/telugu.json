		"excuse_me": {"native": "ఏమండీ",
			"respelling": "ay-mun-DEE", "status": "ai",
			"note": "The polite way to get a stranger's attention."},
		"sorry": {"native": "క్షమించండి",
			"respelling": "kshuh-MEEN-chun-dee", "status": "ai"},
