{
	"slug": "tigrinya",
	"name": "Tigrinya",
	"native_name": "ትግርኛ",
	"entries": {
		"hello": {"native": "ሰላም",
			"respelling": "seh-lahm", "status": "ai",
			"note": "'Peace'; even syllables, no strong word stress."},
		"good_morning": {"native": "ከመይ ሓዲርኩም?",
			"respelling": "keh-mey hah-dir-koom", "status": "ai",
			"note": "Polite form; right for a man or a woman."},
		"good_evening": {"native": "ከመይ ኣምሲኹም?",
			"respelling": "keh-mey am-see-khoom", "status": "ai",
			"note": "ኹ is a raspy kh, from the back of the throat."},
		"goodbye": {"native": "ደሓን ኩኑ",
			"respelling": "deh-hahn koo-noo", "status": "ai",
			"note": "Polite 'stay well', said to the one staying."},
		"how_are_you": {"native": "ከመይ ኣለኹም?",
			"respelling": "keh-mey ah-leh-khoom", "status": "ai",
			"note": "Polite; the answer is ጽቡቕ (tsih-book), 'fine'."},
		"thank_you": {"native": "የቐንየለይ",
			"respelling": "yeh-khen-yeh-ley", "status": "ai",
			"note": "ቐ is a sharp k popped at the back of the mouth."},
		"youre_welcome": {"native": "ብደስታ",
			"respelling": "bih-deh-stah", "status": "ai",
			"note": "'With pleasure'; warm reply to thanks."},
		"no_problem": {"native": "ጸገም የብሉን",
			"respelling": "tseh-gem yeb-loon", "status": "ai",
			"note": "'There is no problem'; ጸ is a sharp, popped ts."},
		"please": {"native": "በጃኹም",
			"respelling": "beh-jah-khoom", "status": "ai",
			"note": "Polite form; safe with any stranger."},
		"excuse_me": {"native": "ይቕሬታ",
			"respelling": "yih-khray-tah", "status": "ai",
			"note": "'Pardon' - to get attention or to squeeze past."},
		"sorry": {"native": "ኣይትሓዙለይ",
			"respelling": "ai-tih-hah-zoo-ley", "status": "ai",
			"note": "'Do not hold it against me'; ይቕሬታ works too."},
		"yes": {"native": "እወ",
			"respelling": "ih-weh", "status": "ai"},
		"no": {"native": "ኣይፋል",
			"respelling": "ai-fahl", "status": "ai",
			"note": "Also ኣይኮነን (ai-koh-nen), 'it is not so'."},
		"of_course": {"native": "ብርግጽ",
			"respelling": "bir-gits", "status": "ai",
			"note": "'Certainly'; ጽ is the popped ts, as in ጸገም."},
		"amazing": {"native": "ዘደንቕ!",
			"respelling": "zeh-denk", "status": "ai",
			"note": "'Astonishing'; ቕ is that sharp back-of-mouth k."},
		"delicious": {"native": "ኣዝዩ ጥዑም!",
			"respelling": "ah-zee-yoo tih-oom", "status": "ai",
			"note": "'Very tasty'; ጥ is a sharp, popped t."},
		"cheers": {"native": "ንጥዕናና!",
			"respelling": "nih-tih-nah-nah", "status": "ai",
			"note": "'To our health' - the usual toast."}
	}
}
