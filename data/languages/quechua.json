	"entries": {
		"hello": {"native": "Napaykullayki",
			"respelling": "nah-pie-koo-LYE-kee", "status": "ai",
			"note": "Formal Cusco Quechua greeting; warm and respectful."},
		"good_morning": {"native": "Allin tutamanta",
			"respelling": "AH-yeen too-tah-MAHN-tah", "status": "ai",
			"note": "Also seen as 'Allin p'unchay' (day-based) in phrasebooks; back-translation confirms this form means good morning."},
		"good_evening": {"native": "Allin ch'isi",
			"respelling": "AH-yeen CHEE-see", "status": "ai",
			"note": "Ch'isi means dusk/evening; fuller phrasebook form is 'Allin ch'isi tuta'."},
		"goodbye": {"native": "Tupananchiskama",
			"respelling": "too-pah-nahn-chees-KAH-mah", "status": "ai",
			"note": "Literally 'until we meet again'."},
		"how_are_you": {"native": "Imaynallan kashanki?",
			"respelling": "ee-my-nah-LYAHN kah-SHAHN-kee", "status": "ai",
			"note": "Simpler alternative: Allillanchu?, which phrasebooks mark as the more formal greeting."},
		"thank_you": {"native": "Sulpayki",
			"respelling": "sool-PIE-kee", "status": "ai",
			"note": "Cusco Quechua for thanks; Añay is also heard."},
		"no_problem": {"native": "Mana imapas",
			"respelling": "MAH-nah ee-MAH-pahs", "status": "ai"},
		"please": {"native": "Ama hina kaspa",
			"respelling": "AH-mah HEE-nah KAHS-pah", "status": "ai",
			"note": "Shorter alternative: Allichu."},
		"excuse_me": {"native": "Dispensariway",
			"respelling": "dees-pen-sah-ree-WHY", "status": "ai",
			"note": "Adapted from Spanish; widely used in Cusco Quechua."},
		"sorry": {"native": "Pampachaykuway",
			"respelling": "pahm-pah-chai-koo-WHY", "status": "ai",
			"note": "Literally 'forgive me'."},
		"yes": {"native": "Arí",
			"respelling": "ah-REE", "status": "ai"},
		"no": {"native": "Mana",
			"respelling": "MAH-nah", "status": "ai"},
		"amazing": {"native": "Sumaq!",
			"respelling": "SOO-mahk", "status": "ai",
